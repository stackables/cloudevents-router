{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>stackables/renovate-config"],
  "semanticCommits": "disabled",
  "packageRules": [
    {
      "description": "Published package: a major update of a runtime dependency widens the range, so users on the old major keep working without changing anything",
      "matchFileNames": ["package.json"],
      "matchDepTypes": ["dependencies", "peerDependencies"],
      "rangeStrategy": "widen"
    },
    {
      "description": "Coverage and CodeQL check every update",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ],
  "lockFileMaintenance": {
    "automerge": true
  }
}
